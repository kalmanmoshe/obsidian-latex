{
  "name": "latex-render",
  "version": "0.2.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,md,yml,yaml,html}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "build-worker": "esbuild src/latexRender/swiftlatexpdftex.worker.js --bundle --outfile=dist/s.worker.js --format=esm",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "update-utils": "npm uninstall obsidian-dev-utils && npm install kalmanmoshe/obsidian-dev-utils#main"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@rollup/plugin-wasm": "^6.2.2",
    "@types/electron": "^1.4.38",
    "@types/node": "^16.11.6",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "builtin-modules": "3.3.0",
    "canvas": "^3.1.0",
    "depcheck": "^1.4.7",
    "esbuild": "^0.24.2",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "esbuild-plugin-wasm": "^1.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "latest",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.7.4",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@popperjs/core": "^2.11.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/async": "^3.2.24",
    "@types/md5": "^2.3.5",
    "@unified-latex/unified-latex-util-parse": "^1.8.1",
    "async": "^3.2.6",
    "canvg": "^4.0.2",
    "esbuild-plugin-inline-import": "^1.1.0",
    "js-base64": "^3.7.7",
