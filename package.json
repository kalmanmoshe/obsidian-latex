{
  "name": "latex-render",
  "version": "0.2.0",
  "description": "",
  "main": "main.js",
  "scripts": {
     "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,md,yml,yaml,html}\"",
    "typecheck": "tsc --noEmit",
    "unused": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "dev": "node esbuild.config.mjs --meta",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "build:meta": "npm run typecheck && node esbuild.config.mjs production --meta",

    "build-worker": "esbuild src/latexRender/swiftlatexpdftex.worker.js --bundle --outfile=dist/s.worker.js --format=esm",

    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "update-utils": "npm uninstall obsidian-dev-utils && npm install kalmanmoshe/obsidian-dev-utils#main",

    "generate:payloads": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-compressed-payloads.ps1",
    "build:swiftlatex": "powershell -ExecutionPolicy Bypass -File ./build-swiftlatex.ps1 && npm run generate:payloads",
    "build:all": "npm run build:swiftlatex && npm run build",

    "push:android": "powershell -ExecutionPolicy Bypass -File ./scripts/push-android.ps1"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@rollup/plugin-wasm": "^6.2.2",
    "@types/electron": "^1.4.38",
    "@types/node": "^16.11.6",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.24.2",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "esbuild-plugin-wasm": "^1.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "knip": "^6.24.0",
    "obsidian": "latest",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.7.4",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@popperjs/core": "^2.11.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/async": "^3.2.24",
    "@unified-latex/unified-latex-util-parse": "^1.8.1",
    "async": "^3.2.6",
    "chokidar": "^4.0.3",
    "clear-module": "^4.1.2",
    "esbuild-plugin-inline-import": "^1.1.0",
    "hebcal": "^2.3.2",
    "import-fresh": "^3.3.0",
    "js-base64": "^3.7.7",
    "js-beautify": "^1.15.1",
    "jsdom": "^26.1.0",
    "localforage": "^1.10.0",
    "obsidian-dev-utils": "github:kalmanmoshe/obsidian-dev-utils#main",
    "piscina": "^5.0.0-alpha.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.12.0",
    "set.prototype.difference": "^1.1.6",
    "set.prototype.intersection": "^1.1.7",
    "svgo": "^4.0.2",
    "svgo-unique-id": "^1.0.0",
    "svgson": "^5.3.1",
    "ts-md5": "^1.3.1"
  }
}
