    "obsidian-dev-utils": "github:kalmanmoshe/obsidian-dev-utils#main",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.12.0",
    "set.prototype.difference": "^1.1.6",
    "set.prototype.intersection": "^1.1.7",
    "svgo": "^3.2.0",
    "svgson": "^5.3.1",
    "ts-md5": "^1.3.1"
  }
